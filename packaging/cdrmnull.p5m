# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
#
# IPS manifest of cdrmnull (drivers/cdrmnull), the C DRM null driver: a
# TEST DRIVER without hardware for the kernel tests of the DRM core
# (tools/test), not for production systems. Its driver-private ioctls
# exist only for those tests. Publish from a directory holding the module
# built by drivers/cdrmnull/build.sh as usr/kernel/drv/amd64/cdrmnull,
# drivers/cdrmnull/cdrmnull.conf as usr/kernel/drv/cdrmnull.conf, and this
# repository's LICENSE:
#
#   pkgsend publish -s <repo> -d <proto> -d . packaging/cdrmnull.p5m
#
# The module is linked with -N misc/drm, so the package depends on the
# package that delivers misc/drm (modules/drm).
#
# The driver action attaches the pseudo device of cdrmnull.conf and gives
# the card and render nodes mode 0666, as the test runs expect. The devlink
# attribute makes devfsadm create /dev/dri/card<N> and
# /dev/dri/renderD<128+N> where the SUNW_drm_link module of OpenIndiana's
# DRM package is not installed (see devlink.tab).
#
set name=pkg.fmri value=pkg://illumos-drm/driver/graphics/cdrmnull@0.0.1,5.11-2026.0.0.0
set name=pkg.summary value="C DRM null driver for testing the DRM core (test driver)"
set name=pkg.description value="cdrmnull, a test driver of illumos-drm without hardware, written in C against the DRM facade of misc/drm: one pseudo DRM device with card and render nodes, GEM objects and dumb buffers in system memory, sync objects, sync files, PRIME and a test fence timeline, for the kernel tests of the DRM core."
set name=info.classification value=org.opensolaris.category.2008:Drivers/Display
set name=info.source-url value=https://code.aopc.cloud/illumos/illumos-drm
set name=variant.arch value=i386
set name=org.opensolaris.consolidation value=userland
dir  path=usr owner=root group=sys mode=0755
dir  path=usr/kernel owner=root group=sys mode=0755
dir  path=usr/kernel/drv owner=root group=sys mode=0755
dir  path=usr/kernel/drv/amd64 owner=root group=sys mode=0755
file path=usr/kernel/drv/amd64/cdrmnull owner=root group=sys mode=0755 reboot-needed=true
file path=usr/kernel/drv/cdrmnull.conf owner=root group=sys mode=0644 \
    preserve=true
driver name=cdrmnull perms="* 0666 root sys" \
    devlink=type=ddi_display:drm;name=cdrmnull\tdri/\M0
depend fmri=pkg:/driver/graphics/illumos-drm@0.0.1 type=require
license LICENSE license=MPL-2.0
