# file, You can obtain one at https://mozilla.org/MPL/2.0/.
#
# IPS manifest of misc/drm_minor (modules/drm-minor), the table of DRM
# device numbers every illumos-drm driver shares: device N is card<N> and
# renderD<128+N> whichever driver it belongs to. Every driver module is
# linked with -N misc/drm_minor, and its package depends on this one.
# Publish from a directory holding the module linked with its exports
# mapfile as kernel/misc/amd64/drm_minor, and this repository's LICENSE:
#
#   ld -ztype=kmod -B reduce -M modules/drm-minor/exports.mapfile \
#       -z allextract drm_minor.a -o <proto>/kernel/misc/amd64/drm_minor
#   pkgsend publish -s <repo> -d <proto> -d . packaging/drm-minor.p5m
#
# The module has no device nodes and no driver action; the kernel loads it
# with the first driver that needs it.
#
set name=pkg.fmri value=pkg://illumos-drm/driver/graphics/drm-minor@0.0.1,5.11-2026.0.0.0
set name=pkg.summary value="DRM device numbers for the illumos-drm drivers (Rust)"
set name=pkg.description value="misc/drm_minor, the kernel module that gives every DRM device of the illumos-drm Rust drivers its own number, so that /dev/dri/card<N> and /dev/dri/renderD<128+N> never collide between drivers."
set name=info.classification value=org.opensolaris.category.2008:Drivers/Display
set name=info.source-url value=https://code.aopc.cloud/illumos/illumos-drm
set name=variant.arch value=i386
set name=org.opensolaris.consolidation value=userland
dir  path=kernel owner=root group=sys mode=0755
dir  path=kernel/misc owner=root group=sys mode=0755
dir  path=kernel/misc/amd64 owner=root group=sys mode=0755
file path=kernel/misc/amd64/drm_minor owner=root group=sys mode=0755 reboot-needed=true
license LICENSE license=MPL-2.0
