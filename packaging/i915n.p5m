#
# SPDX-License-Identifier: MIT
# Copyright 2026 The illumos-drm authors
#
# IPS manifest of i915n, Linux v7.2's i915 (headless: no display, no
# local memory) built for the illumos-drm facade and misc/linuxkpi
# (drivers/i915). Publish from a directory holding the module linked by
# drivers/i915/build.sh as kernel/drv/amd64/i915n and its licence file
# written by drivers/i915/gen-license.sh as LICENSE.i915n:
#
#   drivers/i915/build.sh all      # $OUT/i915n
#   cp $OUT/i915n <proto>/kernel/drv/amd64/i915n
#   drivers/i915/gen-license.sh $LINUX <proto>/LICENSE.i915n
#   pkgsend publish -s <repo> -d <proto> packaging/i915n.p5m
#
# The driver action has no PCI aliases: the Intel GPU aliases belong to
# gfx-drm's i915 (driver/graphics/drm) until `drmadm select new` moves them
# to i915n (and `drmadm select legacy` back), see drmadm(8). Installing the
# package therefore binds nothing. The card and render nodes get mode 0666
# as for the other DRM drivers, and the devlink attribute makes devfsadm
# create /dev/dri/card<N> and /dev/dri/renderD<128+N> where SUNW_drm_link
# is not installed (packaging/devlink.tab).
#
# The module is linked with -N misc/drm_core -N misc/linuxkpi
# -N misc/drm_helpers, so the package requires their packages. No
# firmware is delivered: execlist submission on gen7 to gen9.5 needs none;
# GuC/HuC firmware is optional there and absent firmware is not an error
# (i915 logs it and continues).
#
set name=pkg.fmri value=pkg://illumos-drm/driver/graphics/i915n@0.0.1,5.11-2026.0.0.0
set name=pkg.summary value="Intel GPU driver from Linux i915, headless (i915n)"
set name=pkg.description value="i915n, the i915 driver of Linux v7.2 without display support, built for the illumos-drm DRM core and its Linux compatibility layer: GEM, execbuffer, contexts and render nodes for Intel integrated GPUs (gen7 to gen9.5 targeted). Ships no PCI aliases; select it with drmadm select new."
set name=info.classification value=org.opensolaris.category.2008:Drivers/Display
set name=info.source-url value=https://code.aopc.cloud/illumos/illumos-drm
set name=variant.arch value=i386
set name=org.opensolaris.consolidation value=userland
dir  path=kernel owner=root group=sys mode=0755
dir  path=kernel/drv owner=root group=sys mode=0755
dir  path=kernel/drv/amd64 owner=root group=sys mode=0755
file path=kernel/drv/amd64/i915n owner=root group=sys mode=0755 reboot-needed=true
driver name=i915n perms="* 0666 root sys" \
    devlink=type=ddi_display:drm;name=i915n\tdri/\M0
depend fmri=pkg:/driver/graphics/drm-core@0.0.1 type=require
depend fmri=pkg:/driver/graphics/linuxkpi@0.0.1 type=require
depend fmri=pkg:/driver/graphics/drm-helpers@0.0.1 type=require
depend fmri=pkg:/driver/graphics/drmadm@0.0.1 type=require
# The facade and the layer are unstable (major version 0): built for these
# versions only.
depend fmri=pkg:/driver/graphics/drm-core@0.0.1 type=incorporate
depend fmri=pkg:/driver/graphics/linuxkpi@0.0.1 type=incorporate
license LICENSE.i915n license=MIT-i915
